<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#E9EFF9">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/logo"
        android:background="@drawable/rectangle2">
        <ImageView
            android:id="@+id/logoImageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/app_logo"
            android:layout_centerHorizontal="true"
            android:maxHeight="145dp"
            android:maxWidth="145dp"
            android:adjustViewBounds="true"
            />
        <TextView
            android:id="@+id/appName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MindBoost"
            android:textStyle="bold"
            android:layout_below="@id/logoImageView"
            android:layout_centerHorizontal="true"
            android:textAlignment="center"
            android:textSize="35sp" />
    </RelativeLayout>



    <TextView
        android:id="@+id/welcomeTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Witaj w MindBoost! \nZaloguj się, bądź zarejestruj, \naby przejść dalej."
        android:textColor="@color/black"
        android:layout_below="@id/logo"
        android:layout_centerHorizontal="true"
        android:textAlignment="center"
        android:layout_marginTop="60dp"
        android:textSize="20sp"
        android:background="@drawable/rectangle1"
        />

    <Button
        android:id="@+id/loginButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Logowanie"
        android:layout_below="@id/welcomeTextView"
        android:background="@drawable/rectangle1"
        android:layout_marginTop="50dp"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp" />

    <Button
        android:id="@+id/registerButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Rejestracja"
        android:background="@drawable/rectangle1"
        android:layout_below="@id/loginButton"
        android:layout_marginTop="16dp"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp" />

    <Button
        android:id="@+id/facebookLoginButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Logowanie przez facebooka"
        android:background="@drawable/rectangle1"
        android:textColor="#FFFFFF"
        style="@style/FacebookButton"
        app:icon="@drawable/icfacebook"
        android:layout_below="@id/registerButton"
        android:layout_marginTop="16dp"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp" />

    <Button
        android:id="@+id/googleLoginButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Logowanie przez Google"
        android:textColor="#FFFFFF"
        android:background="@drawable/rectangle1"
        app:icon="@drawable/icgoogle"
        android:layout_below="@id/facebookLoginButton"
        android:layout_marginTop="16dp"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="48dp"
        style="@style/FacebookButton"
        />

</RelativeLayout>
