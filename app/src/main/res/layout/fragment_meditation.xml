<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:gravity="center"
android:orientation="vertical"
android:background="#E9EFF9"
tools:context=".meditationPage.MeditationFragment">


<TextView
    android:id="@+id/text1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:text="Odkryj spokój medytując!"
    android:textColor="@color/black"
    android:textSize="26dp"
    android:textStyle="bold"
    android:layout_marginTop="15dp"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintBottom_toTopOf="@id/meditationPicture"
    />

    <ImageView
        android:id="@+id/meditationPicture"
        android:layout_width="wrap_content"
        android:layout_height="240dp"
        android:src="@drawable/meditation"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.494"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text1" />

    <TextView
    android:id="@+id/text2"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:text="Zacznij swoją podróż w głęb siebie już dziś! Poświęć kilka minut każdego dnia na medytację i zobacz, jak transformuje się Twoje życie. \n\nZnajdź spokój, zwiększ swoją świadomość i poczuj głęboką łączność z otaczającym Cię światem.

\n\nMedytacja to prosta praktyka, która może przynieść potężne zmiany. Otwórz swoje serce i umysł – rozpocznij swoją podróż medytacyjną już teraz!"
    android:textSize="17dp"
    android:layout_marginLeft="40dp"
        android:layout_marginTop="20dp"
    android:textColor="@color/black"
    android:layout_marginRight="40dp"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@id/meditationPicture" />



<Button
    android:id="@+id/meditationStartBtn"
    android:layout_width="180dp"
    android:layout_height="60dp"
    android:gravity="center"
    android:text="Rozpocznij"
    android:textSize="20dp"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/text2"
    app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
