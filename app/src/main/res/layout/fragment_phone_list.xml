<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:background="#E9EFF9"
    tools:context=".PhoneListFragment">


    <TextView
        android:id="@+id/text1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nie masz do kogo się zwrócić? \nZadzwoń na któryś z poniższych numerów telefonu, a na pewno uzyskasz pomoc!"
        android:textSize="26dp"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:gravity="center"
        android:layout_marginTop="20dp"
        android:layout_centerInParent="true"/>

    <LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/ll1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/text1">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="205dp"
            android:layout_weight="1"
            android:layout_marginRight="5dp"
            android:background="@drawable/rectangle1"
            android:id="@+id/phoneNumber1"
            android:layout_gravity="center"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                >
                <ImageView
                    android:id="@+id/pic1"
                    android:layout_width="122dp"
                    android:layout_height="83dp"
                    android:src="@drawable/ic_rzecznik_praw_dziecka"
                    android:layout_gravity="center_horizontal"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16dp"
                    android:textColor="@color/black"

                    android:text="Bezpłatne wsparcie psychologiczne Rzecznika Praw Dziecka - Mikołaja Pawlaka"
                    android:layout_gravity="center_horizontal"
                    android:gravity="center"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:layout_weight="1"
            android:background="@drawable/rectangle1"
            android:layout_gravity="center"
            android:layout_marginLeft="5dp"
            android:id="@+id/phoneNumber2"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                >
                <ImageView
                    android:id="@+id/pic2"
                    android:layout_width="122dp"
                    android:layout_height="83dp"
                    android:src="@drawable/ic_telefon_zaufania"
                    android:layout_gravity="center_horizontal"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="16dp"
                    android:text="Telefon zaufania dla dzieci i młodzieży fundacji Dajemy dzieciom siłę"
                    android:layout_gravity="center_horizontal"
                    android:gravity="center"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>

    <LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:id="@+id/ll2"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/ll1">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="205dp"
            android:layout_weight="1"
            android:layout_marginRight="5dp"
            android:background="@drawable/rectangle1"
            android:id="@+id/phoneNumber3"
            android:layout_gravity="center"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                >
                <ImageView
                    android:id="@+id/pic3"
                    android:layout_width="122dp"
                    android:layout_height="83dp"
                    android:src="@drawable/ic_antydepresyjny_telefon_zaufania"
                    android:layout_gravity="center_horizontal"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="16dp"
                    android:text="Antydepresyjny telefon zaufania młodych fundacji ITAKA"
                    android:layout_gravity="center_horizontal"
                    android:gravity="center"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:layout_weight="1"
            android:background="@drawable/rectangle1"
            android:layout_gravity="center"
            android:layout_marginLeft="5dp"
            android:id="@+id/phoneNumber4"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                >
                <ImageView
                    android:id="@+id/pic4"
                    android:layout_width="122dp"
                    android:layout_height="83dp"
                    android:src="@drawable/ic_forum_przeciwko_depresji"
                    android:layout_gravity="center_horizontal"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16dp"
                    android:textColor="@color/black"
                    android:text="Antydepresyjny telefon forum przeciwko depresji"
                    android:layout_gravity="center_horizontal"
                    android:gravity="center"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>