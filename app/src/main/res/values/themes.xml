<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.MindBoost" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">#2451EF</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.MindBoost.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="FacebookButton" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@color/facebookColor</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="GoogleButton" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@color/googleColor</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="Theme.MindBoost.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.MindBoost.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>